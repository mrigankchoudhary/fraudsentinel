# FraudSentinel configuration. Copy to .env and edit.
# A real environment variable always beats this file, so
# `FS_LLM_PROVIDER=stub python3 app/server.py` still overrides it.

# --- model provider -------------------------------------------------------
# stub       : offline deterministic reasoner. Pipeline runs, numbers SIMULATED.
# ollama     : open-weight models on this machine.
# openrouter : the same class of models, hosted.
FS_LLM_PROVIDER=stub

# Base URL and model list default to the provider's preset (app/config.py),
# so you only set these to override. Leave blank to take the preset:
#   ollama      -> http://localhost:11434/v1  + mistral:7b,llama3.1:8b,qwen2.5:7b
#   openrouter  -> https://openrouter.ai/api/v1 + the same three by slug
FS_LLM_BASE_URL=
FS_MODELS=
FS_LLM_API_KEY=
FS_LLM_TIMEOUT=120

# --- OpenRouter (only read when FS_LLM_PROVIDER=openrouter) ---------------
# Key from https://openrouter.ai/keys. OPENROUTER_API_KEY is accepted too.
FS_OPENROUTER_API_KEY=

# Attribution, so runs are identifiable in the OpenRouter activity log.
FS_OPENROUTER_APP_NAME=FraudSentinel
FS_OPENROUTER_SITE_URL=http://localhost:8000

# Pin the upstream host before recording latency figures — otherwise two runs
# of one model can be served by two different hosts and the comparison drifts.
FS_OPENROUTER_PROVIDERS=
FS_OPENROUTER_PROVIDERS_ONLY=0
# Refuse upstreams that train on prompts. Prompts carry customer data; leave on.
FS_OPENROUTER_NO_TRAIN=1

# --- app ------------------------------------------------------------------
FS_PROMPT_VERSION=v3
FS_PORT=8000

# --- secrets ---------------------------------------------------------------
# .env is committed, so keep real keys out of it: put them in .env.local,
# which is gitignored and loaded with priority over .env.
#   echo 'FS_OPENROUTER_API_KEY=sk-or-v1-...' >> .env.local
